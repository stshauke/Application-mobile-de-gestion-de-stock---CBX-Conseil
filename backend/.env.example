# ============================================================
# Fichier d'exemple des variables d'environnement.
# Copiez ce fichier en ".env" et adaptez les valeurs à votre machine :
#   cp .env.example .env
# ============================================================

# Port sur lequel le serveur Express écoute
PORT=3000

# Connexion à la base de données MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=stock_management
